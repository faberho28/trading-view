# Alpaca paper trading credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Trading mode: this slice only supports "paper". Any other value raises at startup.
TRADING_MODE=paper

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
